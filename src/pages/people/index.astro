---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { PeopleGrid } from '@/components/PeopleGrid'
import { getAllPeople } from '@/lib/data-utils'
import { getImage } from 'astro:assets'

const rawPeople = await getAllPeople()

const people = await Promise.all(
  rawPeople.map(async (person) => ({
    ...person,
    data: {
      ...person.data,
      avatar: person.data.avatar
        ? (await getImage({ src: person.data.avatar, width: 256, height: 256 })).src
        : undefined,
    },
  }))
)
---

<Layout class="">
  <PageHead slot="head" title="People" />
  <Breadcrumbs items={[{ label: 'People', icon: 'lucide:users' }]} />
  <PeopleGrid client:only="react" people={people} shuffle />
</Layout>
